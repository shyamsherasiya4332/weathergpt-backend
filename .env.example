# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# OpenAI-Compatible LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Weather API Configuration
WEATHER_API_KEY=optional_weather_api_key
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Geocoding API Configuration
GEOCODING_API_KEY=optional_geocoding_api_key
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Make Webhook URL for Automations / Alerts
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_unique_webhook_id

# Cache TTL Configuration (seconds)
CACHE_TTL_CURRENT=300
CACHE_TTL_FORECAST=900
CACHE_TTL_GEOCODING=86400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
